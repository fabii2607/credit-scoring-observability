        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_batch_status",
          "legendFormat": "{{batch_id}} {{stage}} {{feature}}"
        }
      ],
