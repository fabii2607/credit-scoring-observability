# Copie para .env (make setup faz isso) e nunca commite o .env.

# ── Privacidade ──────────────────────────────────────────────────────────────
# Sal usado para pseudonimizar o customer_id (SHA-256). Troque o valor e não o
# compartilhe fora do grupo: sem ele o hash não é revertido por dicionário.
PSEUDONYMIZATION_SALT=troque-este-sal

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Configuração de Ambiente ──────────────────────────────────────────────────
PYTHONPATH=src
GIT_PYTHON_REFRESH=quiet

# ── Etapa 3 (observabilidade) ────────────────────────────────────────────────
# Vazios = o pipeline roda offline (sem MLflow remoto, sem Pushgateway, sem traces).
# Para rodar com a stack local do Docker (make up-full), utilize os valores de localhost abaixo:
PUSHGATEWAY_URL=http://localhost:9091
MLFLOW_TRACKING_URI=http://localhost:5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Força a estabilidade e o protocolo correto dos traces (Tempo/Alloy) no Windows/Docker
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces